+// Management services can appear after a robot_description topic initializes
+// the ResourceManager. Cache the unique group only once it is ready; absence
+// remains an explicit not_ready state, never proof that executor workers ended.
+struct ManagementCallbackProbe
+{
+  rclcpp::CallbackGroup::SharedPtr cached_group;
+  std::size_t matching_services{0};
+  bool mutually_exclusive{false};
+  shutdown_order::ManagementGroupState state{shutdown_order::ManagementGroupState::not_ready};
+
+  const char * label() const
+  {
+    return state == shutdown_order::ManagementGroupState::ready ? "ready" : "not_ready";
+  }
+
+  bool observe_busy(const std::shared_ptr<controller_manager::ControllerManager> & cm)
+  {
+    if (!cached_group) {
+      matching_services = 0;
+      rclcpp::CallbackGroup::SharedPtr candidate;
+      const std::string service_name = std::string(cm->get_fully_qualified_name()) + "/switch_controller";
+      cm->for_each_callback_group([&](const rclcpp::CallbackGroup::SharedPtr & group) {
+        group->collect_all_ptrs([](const auto &) {}, [&](const auto & service) {
+          if (service_name == service->get_service_name()) {
+            ++matching_services;
+            candidate = group;
+          }
+        }, [](const auto &) {}, [](const auto &) {}, [](const auto &) {});
+      });
+      mutually_exclusive = candidate && candidate->type() == rclcpp::CallbackGroupType::MutuallyExclusive;
+      state = shutdown_order::management_group_state(matching_services, mutually_exclusive);
+      if (state == shutdown_order::ManagementGroupState::not_ready) { return false; }
+      cached_group = candidate;
+    }
+    return !cached_group->can_be_taken_from().load();
+  }
+};
