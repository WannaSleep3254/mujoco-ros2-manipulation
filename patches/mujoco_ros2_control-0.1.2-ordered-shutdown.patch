+// A GUI close requests the process owner to stop; it must not invalidate the
+// Context while that owner's controller update thread can still be running.
+volatile std::sig_atomic_t render_exit_sigterm_count = 0;
+extern "C" void capture_render_exit_sigterm(int)
+{
+  ++render_exit_sigterm_count;
+}
+
+class ScopedRenderExitSignalCapture
+{
+public:
+  ScopedRenderExitSignalCapture()
+  {
+    render_exit_sigterm_count = 0;
+    struct sigaction action {};
+    action.sa_handler = capture_render_exit_sigterm;
+    sigemptyset(&action.sa_mask);
+    installed_ = sigaction(SIGTERM, &action, &previous_) == 0;
+  }
+  ~ScopedRenderExitSignalCapture()
+  {
+    if (installed_) { sigaction(SIGTERM, &previous_, nullptr); }
+  }
+  bool installed() const { return installed_; }
+  ScopedRenderExitSignalCapture(const ScopedRenderExitSignalCapture&) = delete;
+  ScopedRenderExitSignalCapture& operator=(const ScopedRenderExitSignalCapture&) = delete;
+
+private:
+  struct sigaction previous_ {};
+  bool installed_{ false };
+};
+
 constexpr double TEST_TOLERANCE = 1e-9;
