{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MuJoCo ROS 2 publication report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "title", "published_date", "status", "overview", "findings", "limitations", "provenance", "environment", "sample_groups", "stages", "metrics", "assets", "references"],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/text"},
    "published_date": {"type": "string", "format": "date"},
    "status": {"enum": ["preliminary", "validated", "superseded"]},
    "supersedes": {"$ref": "#/$defs/id"},
    "overview": {"$ref": "#/$defs/text"},
    "findings": {"$ref": "#/$defs/texts"},
    "limitations": {"$ref": "#/$defs/texts"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "workcell", "models", "scenario", "input_kind"],
      "properties": {
        "repository": {"$ref": "#/$defs/https"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workcell": {"$ref": "#/$defs/text"},
        "models": {"$ref": "#/$defs/texts"},
        "scenario": {"$ref": "#/$defs/text"},
        "input_kind": {"enum": ["fixed_joint_targets", "random_joint_targets", "cartesian_targets", "contact_task", "other"]}
      }
    },
    "environment": {"type": "object", "required": ["os", "cpu", "python", "ros", "native_mujoco"], "additionalProperties": {"$ref": "#/$defs/text"}},
    "sample_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "kind", "unique_cases", "observations", "successes", "failures", "seed_policy", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["offline", "gui", "headless", "hardware", "unmeasured"]},
          "unique_cases": {"type": "integer", "minimum": 0},
          "observations": {"type": "integer", "minimum": 0},
          "successes": {"type": ["integer", "null"], "minimum": 0},
          "failures": {"type": ["integer", "null"], "minimum": 0},
          "seed_policy": {"$ref": "#/$defs/text"},
          "description": {"$ref": "#/$defs/text"}
        }
      }
    },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "clock", "coverage", "note"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"},
          "clock": {"$ref": "#/$defs/clock"},
          "coverage": {"enum": ["measured", "partial", "estimated", "unmeasured", "proposed"]},
          "note": {"$ref": "#/$defs/text"}
        }
      }
    },
    "metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "unit", "clock", "scope", "values", "note"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"},
          "unit": {"enum": ["s", "ms", "us", "rad", "m", "mm", "count", "ratio", "percent"]},
          "clock": {"$ref": "#/$defs/clock"}, "scope": {"$ref": "#/$defs/text"},
          "note": {"$ref": "#/$defs/text"},
          "values": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["group_id", "value", "sample_count", "statistic"],
              "properties": {
                "group_id": {"$ref": "#/$defs/id"},
                "value": {"type": ["number", "null"]},
                "sample_count": {"type": "integer", "minimum": 0},
                "statistic": {"enum": ["single", "median", "p50", "p95", "p99", "min", "max", "not_measured"]}
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "label", "role", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"},
          "role": {"enum": ["figure", "data", "legacy_report", "video", "document"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "url"],
        "properties": {"label": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/https"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "https": {"type": "string", "format": "uri", "pattern": "^https://"},
    "clock": {"enum": ["wall", "simulation", "not_applicable"]}
  }
}
