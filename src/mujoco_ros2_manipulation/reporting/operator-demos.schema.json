{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed nonmeasurement document registry (separate from performance reports)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "demos"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "demos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "published_date",
          "overview",
          "manifest_sha256"
        ],
        "properties": {
          "document_type": {
            "type": "string",
            "enum": [
              "functional_demo",
              "design_review",
              "project_overview"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "published_date": {
            "type": "string",
            "format": "date"
          },
          "overview": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
